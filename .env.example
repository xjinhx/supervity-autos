# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# COMMAND CENTER — DATA MANAGER INTEGRATIONS (all optional)
# Data Manager reports each system as "degraded" with a reason when its
# credentials are unset — it never fakes a "healthy" status.
# ------------------------------------------------------------
SLACK_BOT_TOKEN=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# ------------------------------------------------------------
# COMMAND CENTER — SUPABASE (real domain data: config, policy_evaluations,
# workbench_resolutions, Workers, Onboarding_Tasks, hire_risk_state)
# Backend-only — never exposed to the frontend.
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# ------------------------------------------------------------
# COMMAND CENTER — AUTO / SUPERVITY ORCHESTRATOR TRIGGER
# Backend-only — never exposed to the frontend. "Run Orchestrator" in the UI
# calls this real workflow; nothing here is faked/simulated locally.
# ------------------------------------------------------------
SUPERVITY_API_KEY=
AUTO_WORKFLOW_API_BASE=https://auto-workflow-api.supervity.ai
AUTO_ORCHESTRATOR_WORKFLOW_ID=
# Fixed backend constant — never accepted from the frontend, even if sent.
AUTO_ONEDRIVE_FOLDER_PATH=
# Backend defaults used whenever the UI leaves these optional trigger inputs blank.
AUTO_DEFAULT_HR_SLACK_CHANNEL=#hr-escalations
AUTO_DEFAULT_SENSITIVE_LABELS=
AUTO_DEFAULT_NORMAL_LABELS=
# Cloud Run / gunicorn prod worker timeout — the Auto trigger is a blocking
# call, bump this above the httpx timeout used in app/services/auto_client.py.
GUNICORN_TIMEOUT=240

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev
